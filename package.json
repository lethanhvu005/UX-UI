{
  "name": "greenlife-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "expo start --go",
    "dev": "expo start --go",
    "android": "expo start --android --go",
    "ios": "expo start --ios --go",
    "check:expo": "expo install --check",
    "build:mobile": "expo export --platform android --platform ios --output-dir dist-native",
    "dev:web-legacy": "vite --host 127.0.0.1",
    "build:web-legacy": "vite build",
    "start:tunnel": "expo start --go --tunnel --port 8083",
    "start:lan": "node scripts/start-lan.cjs",
    "test:db": "node scripts/test-database.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.22",
    "expo-font": "~58.0.11",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "vite": "^6.0.0"
  },
  "main": "index.js"
}
